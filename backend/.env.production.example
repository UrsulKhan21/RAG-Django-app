DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=api.yourdomain.com

# Frontend origins
FRONTEND_URL=https://yourdomain.com
FRONTEND_URLS=https://yourdomain.com

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=True

# HTTPS / proxy
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
COOKIE_SECURE=True
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/auth/google/callback/

# LLM / vector DB
GROQ_API_KEY=
GEMINI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
EMBED_MODEL_NAME=gemini-embedding-001
EMBED_DIM=768
LLM_MODEL=llama-3.3-70b-versatile

# Rate limiting
THROTTLE_ANON_RATE=60/minute
THROTTLE_USER_RATE=300/minute
THROTTLE_LOGIN_RATE=10/minute
THROTTLE_REGISTER_RATE=5/hour
THROTTLE_REFRESH_RATE=30/minute
THROTTLE_CHAT_QUERY_RATE=30/minute
THROTTLE_SOURCE_WRITE_RATE=20/hour
